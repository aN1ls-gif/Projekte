# Dockerfiles/Stream_Scrape

# 1. Get the prepared pypsark base python
FROM an1ls/pyspark_base:ver_1.0 AS builder

ENV SPARK_VERSION=4.0.2 
ENV HADOOP_VERSION=3
ENV JAVA_VERSION=21
ENV PY4J_VERSION=0.10.9.9

ENV JAVA_HOME="/usr/lib/jvm/java-21-openjdk-amd64"
ENV PATH="${JAVA_HOME}/bin/:${PATH}"

ENV SPARK_HOME="/home/spark"
ENV PATH="${SPARK_HOME}/bin:${PATH}"

ENV PYTHONPATH="${SPARK_HOME}/python/:$PYTHONPATH"
ENV PYTHONPATH="${SPARK_HOME}/python/lib/py4j-${PY4J_VERSION}-src.zip:$PYTHONPATH" 

## See python output in kubernetes
ENV PYTHONUNBUFFERED=1
# 3. Set Working Directory inside the container and copy all neccessary files and dirs
COPY . /app/
# 4. Install the additional neccessary packages
RUN python -m pip install -r requirements/Stream_Dashboard.txt
# 6. Activate non-root user
COPY --chown=appuser:appgroup . .


# 6. Activate non-root user
USER appuser
# 7. Expose port
EXPOSE 80
# 8. check if it works
HEALTHCHECK CMD curl --fail http://localhost:80/_stcore/health
# 9. the command that should be run when the container is started.
ENTRYPOINT ["python", "-m", "streamlit", "run", "src/TableCheck.py", "--server.port=80", "--server.address=0.0.0.0"]